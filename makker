#!/usr/bin/env nu

let metadata = {
  name: "makker"
  version: "2.2.0"
};

const template_c_main = path self ./templates/c/main.c;
const template_cpp_main = path self ./templates/cpp/main.cpp;
const template_zig_bin_main = path self ./templates/zig/bin/main.zig;
const template_zig_bin_build = path self ./templates/zig/bin/build.zig;
const template_zig_bin_build_zon = path self ./templates/zig/bin/build.zig.zon;
const template_zig_lib_root = path self ./templates/zig/lib/root.zig;
const template_zig_lib_build = path self ./templates/zig/lib/build.zig;
const template_zig_lib_build_zon = path self ./templates/zig/lib/build.zig.zon;

def safe_save [
  pout: path
  strin: string
  quiet: bool = false
  force: bool = false
] {
  mut msg = "Created";

  if (($pout | path exists) and not $force) {
    let override = input $"File ($pout) exists. Override? [y/N] ";
    if (($override != "y") and ($override != "Y")) {
      print $"Skipped: ($pout)"
      return;
    } else { $msg = "Updated"; }
  }

  if ($force) { $msg = "Updated"; }

  $strin | save -f $pout
  if not $quiet {
    print $"($msg): ($pout)"
  }
}

def "make add_warnings" [] {
  return "warn_flags = -Wall -Wextra -Wno-unused -pedantic"
}

def "main c" [
  --quiet (-q)
  --warn (-w)
  --force (-f)
  --name: string = "main"
] {
  mut base = "";

  if $warn {
      $base ++= $"(make add_warnings) \n\n"
  }

  $base ++= "build:\n";

  $base ++= $"\tgcc -o ($name) main.c";
  if $warn { $base ++= " $(warn_flags)"; }
  $base ++= "\n";

  $base ++= "run: build\n";
  $base ++= $"\t./($name)\n";
  $base ++= "clean:\n";
  $base ++= $"\trm ($name)\n";

  safe_save main.c (open $template_c_main) $quiet $force
  safe_save Makefile $base $quiet $force
}

def "main cpp" [
  --quiet (-q)
  --warn (-w)
  --force (-f)
  --name: string = "main"
] {
  mut base = "";

  if $warn {
      $base ++= $"(make add_warnings) \n\n"
  }

  $base ++= "build:\n";

  $base ++= $"\tg++ -o ($name) main.cpp";
  if $warn { $base ++= " $(warn_flags)"; }
  $base ++= "\n";

  $base ++= "run: build\n";
  $base ++= $"\t./($name)\n";
  $base ++= "clean:\n";
  $base ++= $"\trm ($name)\n";

  safe_save main.cpp (open $template_cpp_main) $quiet $force
  safe_save Makefile $base $quiet $force
}

def "main zig" [
  --quiet (-q)
  --force (-f)
  --bin
  --lib,
  --name: string
] {
  const name_placeholder = "#PROJ_NAME#"

  if ($bin and $lib) {
    print "Cannot have both --bin and --lib"
    exit 1;
  }

  mkdir src

  if ($lib) {
    if $name == null {
      print "Lib must have a name (hint: use --name flag)"
      exit 1;
    }

    safe_save src/root.zig (open $template_zig_lib_root) $quiet $force

    let build = open $template_zig_lib_build | str replace $name_placeholder $name;
    let build_zon = open $template_zig_lib_build_zon | str replace $name_placeholder $name;

    safe_save build.zig $build $quiet $force
    safe_save build.zig.zon $build_zon $quiet $force
  } else {
    safe_save src/main.zig (open $template_zig_bin_main) $quiet $force

    let build = open $template_zig_bin_build | str replace $name_placeholder ($name | default "main");
    let build_zon = open $template_zig_bin_build_zon | str replace $name_placeholder ($name | default "main");

    safe_save build.zig $build $quiet $force
    safe_save build.zig.zon $build_zon $quiet $force
  }

  if (open ./build.zig.zon | str contains "0xffffffffffffffff") {
    if (which zig | is-not-empty) {
      let output = do -i { zig build } | complete;
      let msg = ($output | get stderr);
      let fingerprint = ($msg
        | split words
        | where (($it | str starts-with "0x") and ($it != "0xffffffffffffffff"))
        | first
      );
      open ./build.zig.zon --raw
        | str replace "0xffffffffffffffff" $fingerprint
        | save ./build.zig.zon -f
    } else {
      print "Cannot generate correct fingerprint because zig binary is missing";
    }
  }
}

def --wrapped main [
  ...args: string
] {
  print $"> ($metadata | get name) ($metadata | get version)"
  print "Usage: makker c|cpp|zig"
}
